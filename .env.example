# Copy to .env.local for local development. Never commit real values.
# Find both in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# There is deliberately NO service role key: the app acts as the signed-in
# user and Postgres Row Level Security decides what they can do. If a later
# week needs it, it goes in Vercel only (never NEXT_PUBLIC_, never here).
